# ========================================================
# IT-ASSIGNMENT ENTERPRISE MULTI-AI CONFIGURATION (TEMPLATE)
# ========================================================

PORT=5000
NODE_ENV=production

DB_FILE=./server/data/production.db.json
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

MASTER_AUTH_SALT=IT_ASSIGNMENT_SUPER_SECRET_SALT_2026_@#!$%

# ========================================================
# 🤖 CON GEMINI 1: PHÂN TÍCH NHU CẦU & TƯ VẤN GIẢI PHÁP
