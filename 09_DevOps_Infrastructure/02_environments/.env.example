# ========================================================
# BIỂU MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE)
# ========================================================

# 1. ỨNG DỤNG CHUNG
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://app.domain.com
API_BASE_URL=https://api.domain.com/v1

# 2. BẢO MẬT & XÁC THỰC JWT
JWT_ACCESS_SECRET=CHANGE_ME_IN_PRODUCTION_SUPER_SECRET_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_REFRESH_SECRET_KEY_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 3. KẾT NỐI CƠ SỞ DỮ LIỆU POSTGRESQL
DATABASE_HOST=postgres-db
DATABASE_PORT=5432
DATABASE_USER=postgres_user
DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_NAME=enterprise_production_db
DATABASE_POOL_MAX=30

# 4. KẾT NỐI BỘ NHỚ ĐỆM REDIS
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# 5. DỊCH VỤ BÊN THỨ BA (PAYMENT & NOTIFICATIONS)
VIETQR_CLIENT_ID=vqr_client_id_here
VIETQR_API_KEY=vqr_api_key_secret
VNPAY_TMN_CODE=vnpay_tmn_code
VNPAY_HASH_SECRET=vnpay_hash_secret_key

SMS_OTP_PROVIDER_KEY=sms_provider_secret_token
SENDGRID_API_KEY=SG.sendgrid_api_key_production

# 6. GIÁM SÁT & CẢNH BÁO
SENTRY_DSN=https://example@sentry.io/123456
TELEGRAM_ALERT_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_ALERT_CHAT_ID=-1001234567890

