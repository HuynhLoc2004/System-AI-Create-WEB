# ========================================================
# CẤU HÌNH MÔI TRƯỜNG CHẠY THỬ NGHIỆM LOCAL (LOCAL / DEV)
# Dự án: [TÊN DỰ ÁN]
# Lưu ý: Sao chép tệp này thành 'local.env' và điền thông tin thực tế
# ========================================================

# 1. ỨNG DỤNG MÔI TRƯỜNG CỤC BỘ
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1

# 2. XÁC THỰC BẢO MẬT JWT (LOCAL TEST SECRETS)
JWT_ACCESS_SECRET=local_development_jwt_access_secret_key_2026_xyz
JWT_REFRESH_SECRET=local_development_jwt_refresh_secret_key_2026_xyz
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 3. KẾT NỐI POSTGRESQL LOCAL (DOCKER / NATIVE)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=project_local_db
DATABASE_SSL=false

# 4. KẾT NỐI REDIS CACHE LOCAL
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 5. DỊCH VỤ GỬI EMAIL THỰC TẾ: GOOGLE MAIL SMTP (GMAIL APP PASSWORD)
# Hướng dẫn lấy key: Tài khoản Google -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng (App Passwords)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_dev_account@gmail.com
MAIL_APP_PASSWORD=abcd_efgh_ijkl_mnop
MAIL_FROM_ADDRESS=no-reply@local.domain.com
MAIL_FROM_NAME="[DEV] Hệ Thống Thông Báo"

# 6. CỔNG THANH TOÁN TÍCH HỢP: SANDBOX KIỂM THỬ (PAYMENT SANDBOXES)
# VietQR Cổng Sandbox
VIETQR_CLIENT_ID=vietqr_sandbox_client_id_dev
VIETQR_API_KEY=vietqr_sandbox_api_key_secret_dev
VIETQR_BANK_ACCOUNT_NO=9704198526191432198
VIETQR_BANK_CODE=970422 # MBBank

# VNPay Cổng Thử Nghiệm Sandbox (vnpayment.vn)
VNPAY_TMN_CODE=TEST_TMN_CODE
VNPAY_HASH_SECRET=TEST_HASH_SECRET_KEY
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/payment-result

# MoMo Cổng Thử Nghiệm Sandbox
MOMO_PARTNER_CODE=MOMO_TEST_CODE
MOMO_ACCESS_KEY=MOMO_ACCESS_KEY_TEST
MOMO_SECRET_KEY=MOMO_SECRET_KEY_TEST
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# 7. LƯU TRỮ HÌNH ẢNH SẢN PHẨM & MEDIA (LOCAL STORAGE / MINIO S3)
STORAGE_DRIVER=local # Tùy chọn: local hoặc minio
STORAGE_LOCAL_PATH=./public/uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# Cấu hình MinIO S3 nếu chạy cụm giả lập S3 ở máy:
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=project-local-media

