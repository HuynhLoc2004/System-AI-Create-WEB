# ========================================================
# CẤU HÌNH MÔI TRƯỜNG MÁY CHỦ THỰC TẾ (PRODUCTION ENVIRONMENT)
# Dự án: [TÊN DỰ ÁN]
# CẢNH BÁO BẢO MẬT: TUYỆT ĐỐI KHÔNG COMMIT TỆP CHỨA GIÁ TRỊ THẬT LÊN GIT!
# Tệp này chỉ lưu trên máy chủ VPS: /opt/projects/[tên_dự_án]/.env (chmod 600)
# ========================================================

# 1. ỨNG DỤNG MÔI TRƯỜNG SẢN XUẤT CHÍNH THỨC
NODE_ENV=production
PORT=3000
APP_URL=https://domain.com
API_URL=https://api.domain.com/v1

# 2. XÁC THỰC BẢO MẬT JWT (PRODUCTION KEYS - TỐI THIỂU 64 KÝ TỰ BẢO MẬT CAO)
JWT_ACCESS_SECRET=CHANGE_ME_SUPER_STRONG_PRODUCTION_SECRET_KEY_MIN_64_CHARS_2026_XYZ
JWT_REFRESH_SECRET=CHANGE_ME_SUPER_STRONG_PRODUCTION_REFRESH_SECRET_MIN_64_CHARS_2026_XYZ
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 3. KẾT NỐI POSTGRESQL PRODUCTION DEDICATED (BẬT SSL TLS 1.3)
DATABASE_HOST=postgres-db
DATABASE_PORT=5432
DATABASE_USER=app_backend_user
DATABASE_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_DB_PASSWORD_2026!
DATABASE_NAME=enterprise_production_db
DATABASE_SSL=true
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=30

# 4. KẾT NỐI REDIS CACHE PRODUCTION
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_REDIS_PASSWORD_2026!
REDIS_MAX_MEMORY=2gb

# 5. DỊCH VỤ GỬI EMAIL SẢN XUẤT: GOOGLE WORKSPACE SMTP / SENDGRID
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=no-reply@domain.com
MAIL_APP_PASSWORD=CHANGE_ME_GOOGLE_WORKSPACE_APP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@domain.com
MAIL_FROM_NAME="Doanh Nghiệp - Hệ Thống Giao Dịch Chính Thức"

# 6. CỔNG THANH TOÁN TÍCH HỢP: PRODUCTION CHÍNH THỨC (TIỀN THẬT)
# VietQR Cổng Thực Tế Doanh Nghiệp (Napay / VietinBank / MBBank)
VIETQR_CLIENT_ID=vqr_live_client_id_production
VIETQR_API_KEY=vqr_live_api_key_secret_production
VIETQR_BANK_ACCOUNT_NO=0123456789999
VIETQR_BANK_CODE=970422
VIETQR_WEBHOOK_SECRET=vqr_webhook_secret_hmac_sha256

# VNPay Cổng Thực Tế Production
VNPAY_TMN_CODE=LIVE_TMN_CODE_DOANH_NGHIEP
VNPAY_HASH_SECRET=LIVE_HASH_SECRET_KEY_DOANH_NGHIEP
VNPAY_PAYMENT_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURN_URL=https://domain.com/checkout/payment-result

# MoMo Cổng Thực Tế Doanh Nghiệp
MOMO_PARTNER_CODE=MOMO_LIVE_PARTNER_CODE
MOMO_ACCESS_KEY=MOMO_LIVE_ACCESS_KEY
MOMO_SECRET_KEY=MOMO_LIVE_SECRET_KEY
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create

# 7. CLOUD LƯU TRỮ HÌNH ẢNH SẢN PHẨM: CLOUDFLARE R2 / AWS S3 (MIỄN PHÍ BĂNG THÔNG)
STORAGE_DRIVER=s3
AWS_REGION=auto
AWS_ACCESS_KEY_ID=CHANGE_ME_R2_OR_S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_R2_OR_S3_SECRET_ACCESS_KEY
AWS_BUCKET_NAME=enterprise-production-assets
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Domain CDN phân phối hình ảnh siêu tốc toàn cầu:
STORAGE_PUBLIC_CDN_URL=https://cdn.domain.com

# 8. GIÁM SÁT BẮT LỖI TẬP TRUNG & BOT CẢNH BÁO
SENTRY_DSN=https://example_sentry_key@o123456.ingest.sentry.io/7891011
TELEGRAM_ALERT_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_ALERT_CHAT_ID=-1001234567890

